# Sensitive Credentials & API Keys (DO NOT COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
core/.env*
!core/.env.example
*.pem
*.key

# Backend Authentication & Secret Vaults
core/backend/keys/user_profile.json
!core/backend/keys/user_profile.example.json
core/backend/security/config.json
!core/backend/security/config.example.json
core/backend/security/master_password.txt
core/backend/security/secret_phrase.txt

# Local Runtime Databases & Generated Embeddings
core/backend/data/faiss_indexes/
core/backend/data/extracted_images/
core/backend/data/graphs/
core/backend/data/projects_db.json
core/backend/data/tasks_db.json
core/backend/data/user_memory.json
core/backend/data/*.pdf
core/backend/data/*.png
core/backend/data/*.jpg

# Leftover empty directories from root executions
/data/
/keys/
/security/

