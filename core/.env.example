# Example Environment Configuration for PaperInsight
# Copy this file to .env.local and update with your actual API keys

# Groq API Key (High-speed LPU inference for Llama 3.1)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Optional: for multi-model routing)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OmniRoute API Key (Optional: local proxy for dynamic fallback)
OMNIROUTE_API_KEY=your_omniroute_api_key_here

# Backend Service URL (Default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000
